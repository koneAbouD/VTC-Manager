<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.tmk</groupId>
    <artifactId>vtc-manager</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>vtc-manager</name>
    <description>Backend VTC Manager - Architecture Hexagonale</description>

    <properties>
        <java.version>21</java.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <lombok.version>1.18.34</lombok.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <springdoc.version>2.6.0</springdoc.version>
        <firebase-admin.version>9.4.3</firebase-admin.version>
        <google-http-client.version>1.45.3</google-http-client.version>
        <!-- Non géré par le parent Spring Boot : la version est donc explicite. -->
        <jacoco.version>0.8.12</jacoco.version>
        <!-- Plancher de couverture des couches métier, vérifié en phase verify.
             Calé juste sous la couverture atteinte (54,9 %) : la règle protège
             l'acquis sans bloquer sur du bruit de mesure. À relever au fil de
             l'enrichissement de la suite, jamais à abaisser pour faire passer une
             build — une baisse signale une régression de couverture, c'est
             précisément ce que la règle doit rendre visible.
             Modules encore non couverts, à traiter pour viser 70 % : auth,
             payment, dashboard, categorieOperation, document, groupe,
             configurationRecette, jourFerie, admin, sousCategorieOperation. -->
        <jacoco.couverture.minimale>0.54</jacoco.couverture.minimale>
    </properties>

    <dependencies>
        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Data JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- PostgreSQL -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Sécurité OAuth2 / Keycloak (Resource Server) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Keycloak Admin Client (gestion utilisateurs, rôles, tokens) -->
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-admin-client</artifactId>
            <version>25.0.2</version>
            <exclusions>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- MapStruct -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

        <!-- OpenAPI / Swagger UI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- MinIO -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>8.5.11</version>
        </dependency>

        <!-- Firebase Admin : envoi des notifications push (FCM HTTP v1).
             Le SDK gère l'obtention et le renouvellement du jeton OAuth2 à partir
             de la clé de compte de service, et surtout il typait les erreurs de
             livraison — UNREGISTERED / INVALID_ARGUMENT — dont dépend la purge
             automatique des tokens d'appareils désinstallés.
             Firestore et Cloud Storage sont exclus : seul le service Messaging
             est utilisé, et ils pèsent l'essentiel du poids du SDK. -->
        <dependency>
            <groupId>com.google.firebase</groupId>
            <artifactId>firebase-admin</artifactId>
            <version>${firebase-admin.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>com.google.cloud</groupId>
                    <artifactId>google-cloud-firestore</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.google.cloud</groupId>
                    <artifactId>google-cloud-storage</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- FirebaseOptions instancie JacksonFactory à la construction : sans cet
             artefact, l'initialisation du SDK échoue par NoClassDefFoundError. Il
             arrivait transitivement par Firestore / Cloud Storage, exclus ci-dessus,
             d'où cette déclaration directe. Version alignée sur le google-http-client
             résolu par firebase-admin. -->
        <dependency>
            <groupId>com.google.http-client</groupId>
            <artifactId>google-http-client-jackson2</artifactId>
            <version>${google-http-client.version}</version>
        </dependency>

        <!-- Extraction PDF : couche texte des relevés + rendu image des quittances
             scannées/photographiées, océrisées ensuite par Tesseract (binaire
             système : apt-get install -y tesseract-ocr tesseract-ocr-fra). -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>2.0.32</version>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Purge des migrations Flyway copiées lors des builds précédents.
                 maven-resources-plugin ne fait qu'ajouter/écraser : un fichier
                 renommé dans src/main/resources (renumérotation d'une migration,
                 typiquement V1.10.1 -> V1.10.2) laisse son ancienne copie dans
                 target/classes, et Flyway voit alors deux migrations pour la même
                 version — « Found more than one migration with version X » — alors
                 que les sources sont saines. On vide donc le répertoire juste avant
                 la copie des ressources : le coût est négligeable (quelques dizaines
                 de fichiers SQL) et le classpath reflète toujours exactement src.
                 excludeDefaultDirectories et les filesets sont volontairement portés
                 par l'execution et non par le plugin, pour ne pas altérer le
                 comportement de `mvn clean`. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <id>purge-migrations-obsoletes</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.outputDirectory}/db/migration</directory>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- Couverture de tests. L'agent instrumente la JVM de surefire, le
                 rapport HTML atterrit dans target/site/jacoco, et `check` fait
                 échouer `mvn verify` si les couches métier passent sous le
                 plancher. La règle ne porte QUE sur application/usecases et
                 application/services : c'est là que vit la règle de gestion.
                 L'infrastructure (adaptateurs JPA, Keycloak, MinIO, FCM) et les
                 contrôleurs REST relèvent de tests d'intégration, pas unitaires,
                 et les inclure ferait tomber la moyenne sans rien garantir. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>preparer-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>rapport-couverture</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>plancher-couverture-metier</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>com/tmk/vtcmanager/application/usecases/**/*.class</include>
                                <include>com/tmk/vtcmanager/application/services/*.class</include>
                            </includes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.couverture.minimale}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
