# Racine de configuration Lombok du module : ne pas remonter plus haut.
config.stopBubbling = true

# Marque le code généré par Lombok (@Builder, @Getter, @RequiredArgsConstructor…)
# de @lombok.Generated, que JaCoCo exclut d'office du calcul de couverture.
# Sans cela, les milliers de lignes de builders et d'accesseurs générés diluent
# la mesure et rendent le seuil de couverture ininterprétable.
lombok.addLombokGeneratedAnnotation = true
